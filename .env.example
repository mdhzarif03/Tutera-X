# ---- Database ----
DATABASE_URL="postgresql://tutera:change-me@localhost:5432/tutera_x?schema=public"

# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Initial teacher (owner) account. Created once at startup if absent. Never overwritten. ----
INITIAL_TEACHER_EMAIL=
INITIAL_TEACHER_PASSWORD=
INITIAL_TEACHER_NAME=Main Administrator

# ---- Nishchit SMS (server-side only) ----
NISHCHIT_API_BASE_URL=https://api.nishchit.tech
# nk_test_... never reaches a carrier. nk_live_... is refused unless ALLOW_LIVE_SMS=true.
NISHCHIT_API_KEY=
NISHCHIT_WEBHOOK_SECRET=
ALLOW_LIVE_SMS=false

# ---- Background jobs ----
# on: this process sends queued SMS. off: run POST /api/jobs/run from a scheduler with CRON_SECRET.
JOB_RUNNER=on
CRON_SECRET=
